# کارزینتل — نمونه امن تنظیمات محیطی
# این فایل را هرگز با secret واقعی commit نکنید؛ cp .env.example .env و مقادیر را پر کنید.
NODE_ENV=development

# Frontend / API. In production NEXT_PUBLIC_API_URL may stay relative when Next.js proxies /api/v1.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_URL=
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000/api/v1
SWAGGER=true

# Supabase PostgreSQL (use the pooled URL for the API; use the direct URL for migrations).
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_LOGGING=false
# Optional explicit connection fields when DATABASE_URL is not used.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-a-real-password

# Optional Supabase Auth bridge (the API's existing JWT flow remains supported).
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# Redis (recommended for production rate limits, refresh-token revocation and jobs).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-real-redis-password
REDIS_DB=0
REDIS_PREFIX=krz:

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
BCRYPT_ROUNDS=12

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Search (optional; the API falls back to database search)
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=replace-with-meilisearch-key
MEILI_INDEX=products

# Object storage (Supabase Storage is recommended; S3-compatible storage is also supported).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=product-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Payment gateways
PAYMENT_GATEWAY=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true
NEXTPAY_API_KEY=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SAMAN_TERMINAL_ID=
PAYMENT_CALLBACK_BASE=http://localhost:4000/api/v1/payments/callback
PAYMENT_FRONT_RESULT_URL=http://localhost:3000/checkout/callback

# Notifications
VAPID_SUBJECT=mailto:no-reply@karzintell.ir
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
KAVENEGAR_OTP_TEMPLATE=
BACKUP_SMS_API_KEY=
BACKUP_SMS_SENDER=
BACKUP_SMS_OTP_TEMPLATE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@karzintell.ir

# Security / observability
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Seed. Leave password empty to generate a one-time password in the seed command output.
SEED_ADMIN_PHONE=09000000000
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EXTRA_SUPER_ADMIN_EMAIL=
SEED_EXTRA_SUPER_ADMIN_PHONE=
SEED_EXTRA_SUPER_ADMIN_PASSWORD=
