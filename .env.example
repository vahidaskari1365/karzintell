# ============================================================================
#  کارزینتل — متغیرهای محیطی (نمونه هماهنگ‌شده با کد)
#  توسعه:  cp .env.example .env
#  استقرار روی هاست:  cp .env.example .env  ← مقادیر واقعی را پر کنید
#                      docker compose -f docker-compose.prod.yml up -d --build
# ============================================================================
# ------------------------------- عمومی
NODE_ENV=production
# آدرس عمومی API (برای فرانت) — در production آدرس واقعی مثل https://api.karzintell.ir/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# آدرس عمومی سایت (سئو/سایت‌مپ)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=کارزینتل
# آدرس عمومی فایل‌ها (MinIO/S3)
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/karzintell
# ------------------------------- بک‌اند
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SWAGGER=false
# ------------------------------- پایگاه‌داده (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=karzintell
DB_USER=karzintell
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
DB_LOGGING=false
# ------------------------------- Redis (کش + صف + RateLimit)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_PREFIX=krz:
# ------------------------------- احراز هویت (JWT) — تولید: openssl rand -base64 48
# ⚠️ در Production این دو مقدار اجباری است و برنامه با مقدار پیش‌فرض/ضعیف بالا نمی‌آید.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# ورود با گوگل — Client ID اپلیکیشن (برای اعتبارسنجی audience توکن ID)
GOOGLE_CLIENT_ID=
# ------------------------------- جستجو (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=masterKey123
MEILI_INDEX=products
# ------------------------------- فایل‌ها (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ir-thr-at1
S3_BUCKET=karzintell
S3_ACCESS_KEY=karzintell
S3_SECRET_KEY=secret_secret_secret
S3_PUBLIC_URL=http://localhost:9000/karzintell
# ------------------------------- درگاه پرداخت (کلیدها از پنل درگاه)
PAYMENT_GATEWAY=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true
NEXTPAY_API_KEY=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SAMAN_TERMINAL_ID=
PAYMENT_CALLBACK_BASE=http://localhost:4000/api/v1/payments/callback
PAYMENT_FRONT_RESULT_URL=http://localhost:3000/checkout/callback
# ------------------------------- اعلان مرورگر (Web Push) — npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:no-reply@karzintell.ir
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ------------------------------- پیامک (OTP) — Kavenegar + گیتوی پشتیبان (IPPanel)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
KAVENEGAR_OTP_TEMPLATE=karzintell-otp
BACKUP_SMS_API_KEY=
BACKUP_SMS_SENDER=3000505
BACKUP_SMS_OTP_TEMPLATE=otp
# ------------------------------- ایمیل (SMTP واقعی — مثلاً Mailgun/SMTP.ir)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=کارزینتل <no-reply@karzintell.ir>
# ------------------------------- امنیت
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://karzintell.vercel.app
SENTRY_DSN=
# ------------------------------- Seed (ایجاد ادمین پیش‌فرض — فقط بار اول)
# اگر SEED_ADMIN_PASSWORD ست نشود، یک رمز تصادفی تولید و یک‌بار در لاگ چاپ می‌شود.
SEED_ADMIN_PHONE=09000000000
SEED_ADMIN_EMAIL=admin@karzintell.ir
SEED_ADMIN_PASSWORD=
# ادمین ارشد اضافی اختیاری
SEED_EXTRA_SUPER_ADMIN_EMAIL=
SEED_EXTRA_SUPER_ADMIN_PHONE=
SEED_EXTRA_SUPER_ADMIN_PASSWORD=
