# ============================================================================
# کارزینتل — نمونه امن تنظیمات محیطی (cPanel / Shared Hosting با MySQL)
#
# این فایل را هرگز با secret واقعی commit نکنید:
#   cp .env.example .env   (و داخل apps/api هم .env بگذارید — توضیح در DEPLOY-CPANEL.md)
#
# معماری Production:
#   Browser → https://karzintell.com (Frontend Next.js روی هاست)
#          → /api/v1 → Backend Node.js روی همان هاست (اپ جدا در cPanel)
#          → MySQL/MariaDB روی همان هاست
# هیچ وابستگی اجباری به Vercel، Supabase، PostgreSQL، Docker، Redis یا Meilisearch ندارد.
# ============================================================================

NODE_ENV=production

# =============================================================================
# دامنه و URLها
# =============================================================================
# دامنه واقعی سایت (مطابق DNS هاست ایران)
NEXT_PUBLIC_SITE_URL=https://karzintell.com
NEXT_PUBLIC_APP_URL=https://karzintell.com

# مرورگر همیشه از همین Origin API صدا می‌زند (relative) —
# فوروارد به Backend را سرور Next.js انجام می‌دهد (next.config.ts)
NEXT_PUBLIC_API_URL=/api/v1

# Backend (اپ Node.js جدا در cPanel):
#  - اگر Backend روی ساب‌دامن است:  http://api.karzintell.com
#  - اگر با پورت داخلی:            http://127.0.0.1:4000
# این متغیر فقط در سمت Server (فرانت‌اند) خوانده می‌شود
BACKEND_URL=http://127.0.0.1:4000

# API
API_PORT=4000
# URL عمومی Backend — برای تولید لینک پرداخت/کبک‌بک و presign
API_PUBLIC_URL=https://karzintell.com
WEB_URL=https://karzintell.com
SWAGGER=false

# =============================================================================
# دیتابیس — MySQL / MariaDB روی هاست cPanel
# (در cPanel: Databases → MySQL Databases؛ مقادیر دقیق همان‌جا نمایش داده می‌شود)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
# نام کاربری دیتابیس cPanel معمولاً PREFIX_user است
DB_USER=karzinte_user
DB_PASSWORD=your-database-password
# نام دیتابیس cPanel معمولاً PREFIX_db است
DB_NAME=karzinte_db

# اتصال
# در Shared Hosting مقدار ۵ توصیه می‌شود (کمتر از حد پیش‌فرض MySQL cPanel)
DB_POOL_SIZE=5
DB_LOGGING=false

# =============================================================================
# ذخیره‌سازی فایل‌ها — پیش‌فرض: روی دیسک خود هاست (بدون هیچ سرویس خارجی)
# =============================================================================
# driver: local (پیش‌فرض، مناسب cPanel) | s3 (اختیاری، مقیاس بیشتر)
STORAGE_DRIVER=local
# پوشه فایل‌ها روی دیسک (نسبت به ریشه apps/api). فایل‌ها از /uploads سرو می‌شوند.
STORAGE_DIR=uploads
# URL عمومی فایل‌ها — پیش‌فرض: https://karzintell.com/uploads (از API_PUBLIC_URL)
# فقط وقتی storage روی S3 است یا فایل‌ها جای دیگری سرو می‌شوند، این را تغییر دهید
STORAGE_PUBLIC_URL=

# --- S3 / MinIO — فقط اگر STORAGE_DRIVER=s3 (اختیاری) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# =============================================================================
# JWT — حتماً با دستور زیر تولید کنید (هر کدام ≥ 32 کاراکتر تصادفی):
#   openssl rand -base64 48
# =============================================================================
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
BCRYPT_ROUNDS=12

# Google sign-in (اختیاری — خالی بماند = غیرفعال)
GOOGLE_CLIENT_ID=

# =============================================================================
# Redis — اختیاری؛ بدون آن سایت با حافظه داخلی کار می‌کند
# =============================================================================
# خالی بگذارید تا Redis کاملاً غیرفعال شود:
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=krz:

# =============================================================================
# Meilisearch — اختیاری؛ بدون آن جستجو با MySQL انجام می‌شود
# =============================================================================
MEILI_HOST=
MEILI_API_KEY=
MEILI_INDEX=products

# =============================================================================
# درگاه پرداخت (حداقل یک درگاه یا PAYMENT_GATEWAY=manual)
# =============================================================================
PAYMENT_GATEWAY=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
IDPAY_API_KEY=
IDPAY_SANDBOX=false
NEXTPAY_API_KEY=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SAMAN_TERMINAL_ID=
# کبک‌بک درگاه‌ها به Backend (از طریق همان دامنه — Frontend فوروارد می‌کند)
PAYMENT_CALLBACK_BASE=https://karzintell.com/api/v1/payments/callback
PAYMENT_FRONT_RESULT_URL=https://karzintell.com/checkout/callback

# =============================================================================
# اعلان‌ها: Web Push / SMS / Email
# =============================================================================
VAPID_SUBJECT=mailto:no-reply@karzintell.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS: log = فقط در لاگ (بدون سرویس) | kavenegar = کاوه‌نگار
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
KAVENEGAR_OTP_TEMPLATE=
BACKUP_SMS_API_KEY=
BACKUP_SMS_SENDER=
BACKUP_SMS_OTP_TEMPLATE=

# SMTP (ایمیل ادمین/کاربر — در cPanel معمولاً smtp.karzintell.com یا IP هاست)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@karzintell.com

# =============================================================================
# امنیت
# =============================================================================
# فقط دامنه واقعی سایت (در development فقط localhost مجاز است)
CORS_ORIGINS=https://karzintell.com,https://www.karzintell.com
# رصد خطای Sentry — اختیاری؛ خالی بماند = غیرفعال (هیچ وابستگی خارجی لود نمی‌شود)
SENTRY_DSN=

# =============================================================================
# Seed (داده‌های اولیه — فقط با npm run seed استفاده می‌شود)
# =============================================================================
SEED_ADMIN_PHONE=09000000000
SEED_ADMIN_EMAIL=admin@karzintell.com
SEED_ADMIN_PASSWORD=your-strong-admin-password
# برای ایجاد یک محصول نمونه (اختیاری)
# SAMPLE_DATA=1

# =============================================================================
# ترتیب اجرای Production روی cPanel (داخل apps/api):
#   npm install
#   npm run build
#   npm run db:migrate
#   npm run seed
#   npm start
# راهنمای کامل: DEPLOY-CPANEL.md
# =============================================================================
