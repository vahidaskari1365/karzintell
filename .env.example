# ============================================================================
#  کارزینتل — متغیرهای محیطی (نمونه)
#  مرحله استفاده:  cp .env.example .env
# ============================================================================

# ------------------------------- عمومی
NODE_ENV=development
APP_NAME=karzintell

# ------------------------------- وب (Next.js) — apps/web/.env.local
NEXT_PUBLIC_APP_NAME=کارزینتل
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------- بک‌اند (NestJS) — apps/api/.env
API_PORT=4000
API_PREFIX=api/v1
API_SWAGGER=true

# ------------------------------- پایگاه‌داده (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=karzintell
DB_USERNAME=karzintell
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
DB_LOGGING=false

# ------------------------------- Redis (کش + BullMQ + RateLimit)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_PREFIX=krz:

# ------------------------------- احراز هویت (JWT)
# تولید: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900            # ۱۵ دقیقه (ثانیه)
JWT_REFRESH_TTL=2592000       # ۳۰ روز (ثانیه)

# ------------------------------- جستجو (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey123
MEILI_PRODUCTS_INDEX=products

# ------------------------------- فایل‌ها (MinIO ← سازگار با AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ir-thr-at1
S3_BUCKET=karzintell
S3_ACCESS_KEY=karzintell
S3_SECRET_KEY=secret_secret_secret
S3_PUBLIC_URL=http://localhost:9000/karzintell
# در production فقط با تنظیم همین متغیرها به AWS S3 سوییچ می‌کنیم؛ کد تغییر نمی‌کند.

# ------------------------------- درگاه پرداخت (مرحله‌های بعد)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback

# ------------------------------- پیامک (OTP) — Kavenegar / Ghasedak
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_OTP_TEMPLATE=karzintell-otp

# ------------------------------- ایمیل (توسعه: MailHog)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@karzintell.ir
MAIL_FROM_NAME=کارزینتل

# ------------------------------- امنیت
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
