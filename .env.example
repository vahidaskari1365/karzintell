# ============================================================================
# کارزینتل — نمونه امن تنظیمات محیطی
# این فایل را هرگز با secret واقعی commit نکنید؛ cp .env.example .env و مقادیر را پر کنید.
# دیتابیس: MySQL 8 / MariaDB (سازگار با cPanel)
# ============================================================================

NODE_ENV=production

# =============================================================================
# Frontend / API URLs
# =============================================================================
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://karzintell.ir
NEXT_PUBLIC_APP_URL=https://karzintell.ir
NEXT_PUBLIC_STORAGE_URL=https://your-storage-url.com

API_PORT=4000
API_PUBLIC_URL=https://karzintell.ir
WEB_URL=https://karzintell.ir
INTERNAL_API_URL=http://localhost:4000/api/v1
SWAGGER=false

# =============================================================================
# Database - MySQL/MariaDB (cPanel)
# =============================================================================
# تنظیمات اتصال به دیتابیس MySQL روی هاست cPanel
DB_HOST=localhost
DB_PORT=3306
DB_USER=karzinte_user
DB_PASSWORD=your-database-password
DB_NAME=karzinte_db

# Charset برای پشتیبانی از UTF-8 فارسی
DB_CHARSET=utf8mb4
DB_TIMEZONE=+03:30

# Connection pool
DB_POOL_SIZE=10
DB_LOGGING=false

# =============================================================================
# Redis (اختیاری - برای production توصیه می‌شود)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_PREFIX=krz:

# =============================================================================
# JWT — حتماً با دستور زیر تولید کنید:
# openssl rand -base64 48
# =============================================================================
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
BCRYPT_ROUNDS=12

# Google sign-in (اختیاری)
GOOGLE_CLIENT_ID=

# =============================================================================
# Search (اختیاری - MeiliSearch)
# =============================================================================
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=replace-with-meilisearch-key
MEILI_INDEX=products

# =============================================================================
# Object Storage (S3-compatible)
# =============================================================================
S3_ENDPOINT=https://your-s3-endpoint.com
S3_REGION=auto
S3_BUCKET=product-media
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_PUBLIC_URL=https://your-s3-bucket-url.com

# =============================================================================
# Payment Gateways
# =============================================================================
PAYMENT_GATEWAY=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
IDPAY_API_KEY=
IDPAY_SANDBOX=false
NEXTPAY_API_KEY=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SAMAN_TERMINAL_ID=
PAYMENT_CALLBACK_BASE=https://karzintell.ir/api/v1/payments/callback
PAYMENT_FRONT_RESULT_URL=https://karzintell.ir/checkout/callback

# =============================================================================
# Notifications
# =============================================================================
VAPID_SUBJECT=mailto:no-reply@karzintell.ir
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
KAVENEGAR_OTP_TEMPLATE=
BACKUP_SMS_API_KEY=
BACKUP_SMS_SENDER=
BACKUP_SMS_OTP_TEMPLATE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@karzintell.ir

# =============================================================================
# Security / Observability
# =============================================================================
CORS_ORIGINS=https://karzintell.ir
SENTRY_DSN=

# =============================================================================
# Seed Configuration
# =============================================================================
# رمز عبور ادمین - حتماً تنظیم کنید!
SEED_ADMIN_PHONE=09000000000
SEED_ADMIN_EMAIL=admin@karzintell.ir
SEED_ADMIN_PASSWORD=your-admin-password

# برای ایجاد داده نمونه محصولات
# SAMPLE_DATA=1

# =============================================================================
# Notes for cPanel Deployment:
# =============================================================================
# 1. دیتابیس MySQL را در cPanel ایجاد کنید
# 2. فایل database/20260825000000_initial_store_mysql.sql را در phpMyAdmin اجرا کنید
# 3. npm install && npm run build && npm run seed && npm start
# =============================================================================
