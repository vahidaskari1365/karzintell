# ============================================================================
# Karzintell CI/CD — Local Configuration
# ============================================================================
#
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید:
#   cp .env.local.example .env.local
#
# این فایل هرگز در git commit نمی‌شود (در .gitignore است).
# ============================================================================

# ── smee.io Channel ────────────────────────────────────────────────────────
# یک channel رایگان در https://smee.io بسازید و URL آن را اینجا بگذارید
# مثال: https://smee.io/abc123xyz
SMEE_URL=https://smee.io/REPLACE-WITH-YOUR-CHANNEL

# ── Webhook Secret ─────────────────────────────────────────────────────────
# یک secret قوی بسازید (حداقل 32 کاراکتر) و همان را در GitHub webhook تنظیم کنید
# مثال تولید: openssl rand -hex 32
WEBHOOK_SECRET=REPLACE-WITH-STRONG-SECRET-AT-LEAST-32-CHARS

# ── GitHub Repository ──────────────────────────────────────────────────────
REPO_OWNER=vahidaskari1365
REPO_NAME=karzintell
BRANCH=main

# ── SSH Connection to cPanel Server ────────────────────────────────────────
SSH_HOST=linux25.centraldnserver.com
SSH_PORT=22
SSH_USER=karzinte

# ── SSH Private Key Path ───────────────────────────────────────────────────
# مسیر فایل کلید خصوصی SSH که قبلاً ساختید
# در ویندوز: C:\Users\YOUR_USERNAME\.ssh\karzintell_github_actions
SSH_PRIVATE_KEY_PATH=C:\Users\ASKARI\.ssh\karzintell_github_actions
